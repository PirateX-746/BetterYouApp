# Copy to deploy/.env on the server. Used by docker compose itself.

# The domain the app is served on (no https://, no trailing slash).
# Its DNS A record must point at this server's IP before the first start.
DOMAIN=app.yourclinic.com

# Same value as PASSWORD_ENCRYPTION_KEY in backend/.env.production, or leave
# both empty. Baked into the frontend build, so rebuild after changing it.
PASSWORD_ENCRYPTION_KEY=
