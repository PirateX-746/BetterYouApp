# Copy to .env and fill in. Never commit .env — it is gitignored.

# ---- Core ----------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=<a long random string>
JWT_EXPIRES_IN=1d
PORT=3002
FRONTEND_URL=http://localhost:3000

# Controls whether the forgot-password endpoint may return the temporary
# password in its response. MUST be "production" in any deployed
# environment, or that endpoint leaks the temp password to any caller.
NODE_ENV=development

# Second, independent gate on the same leak — the forgot-password endpoint
# only echoes the temp password if NODE_ENV is not "production" AND this is
# explicitly "true". A production deploy that forgets to set NODE_ENV is
# still safe as long as this was never set. Never set this in production.
ALLOW_DEV_PASSWORD_RESET_ECHO=false

# ---- Password transport obfuscation --------------------------------
# Shared with the frontend's NEXT_PUBLIC_PASSWORD_ENCRYPTION_KEY (must be
# identical). The frontend AES-GCM-encrypts password fields so they don't
# show in plain text in DevTools; the API decrypts them before validation.
# This only OBSCURES: the frontend copy ships in the browser bundle. HTTPS
# is the real protection. Unset on both sides = passwords sent as-is.
PASSWORD_ENCRYPTION_KEY=<a long random string>

# ---- Proxy / client IP ----------------------------------------------
# Number of reverse proxies in front of the API (or their addresses), so
# the real client IP is read from X-Forwarded-For. The rate limiter keys on
# it: left unset behind a proxy, ALL users share one IP and one limit.
#   unset  -> local dev / API reached directly
#   1      -> one platform edge proxy (Railway, Render, Fly, ...)
#   2      -> browser calls go through the Vercel /api rewrite AND an edge
# Too high a number lets clients spoof their IP; "true" is refused in
# production. Verify after deploy: two clients from different networks
# must get independent login limits.
# TRUST_PROXY=1

# ---- Multi-tenancy -------------------------------------------------
# Master switch for the tenancy layer. While this is unset or false the
# resolver runs but enforces nothing and no collection is tenant-scoped,
# so the app behaves exactly as it did before tenancy was introduced.
#
# Do NOT turn this on until migration 001 reports a clean verify AND 002
# has run — with it on, any document missing a practiceId becomes
# invisible to the app.
MULTI_TENANCY_ENABLED=false

# Apex the tenant subdomain is derived from.
#   development: localhost      -> abc.localhost:3000
#   production:  betteryou.app  -> abc.betteryou.app
ROOT_DOMAIN=localhost

# Subdomain reserved for the platform console. Also in the reserved list
# in practice.schema.ts, so no practice can ever claim it.
ADMIN_SUBDOMAIN=admin

# ---- Document file storage ---------------------------------------
# Scanned / uploaded patient documents (PDF). Leave R2_BUCKET unset to
# store files in a private MongoDB GridFS bucket ("documentFiles") —
# fine for development. Set R2_BUCKET to use Cloudflare R2 instead; the
# other three are then required and the server refuses to start without
# them. Use a PRIVATE bucket: files are only ever streamed through the
# authorized GET /documents/:id/file endpoint, never by public URL.
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ---- Migration 001 (optional overrides) ----------------------------
# Identity given to the practice created from your existing data.
# SEED_PRACTICE_NAME=BetterYou Clinic
# SEED_PRACTICE_SUBDOMAIN=betteryou
