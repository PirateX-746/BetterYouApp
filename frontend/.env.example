# Copy to .env and fill in. Never commit the real .env.
BACKEND_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002
CLINIC_PRACTITIONER_ID=

# Must equal the backend's PASSWORD_ENCRYPTION_KEY. Password fields are
# AES-GCM-encrypted before they leave the browser so they don't show in
# plain text in DevTools. Public by design (it's in the JS bundle): this
# obscures, HTTPS protects. Leave unset on both sides to send as-is.
NEXT_PUBLIC_PASSWORD_ENCRYPTION_KEY=
