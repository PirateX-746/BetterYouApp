# dependencies
node_modules/

# env files — every variant except the documented template
.env
.env.*
!.env.example

# build outputs
.next/
dist/
build/

# TypeScript incremental build cache — regenerated on every build
*.tsbuildinfo
# Regenerated by `next dev`/`next build`; Next's own template ignores it
next-env.d.ts

# Test output and tool caches
coverage/
test-results/
playwright-report/
blob-report/
.eslintcache
.vercel/
.turbo/
__pycache__/
*.pyc

# logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
**/.DS_Store
# Added by code-review-graph
.code-review-graph/

# Local DB export — contains PII and bcrypt password hashes, never commit
better-you-app.patients.json

# Playwright MCP session artifacts
.playwright-mcp/

# ---------------------------------------------------------------------------
# Per-developer tooling. These are local assistant/editor state, not project
# config — they differ per machine and cause noisy diffs.
# ---------------------------------------------------------------------------

# Other AI assistants
.qoder/
QODER.md
.kiro/
.cursor/
.cursorrules
.windsurfrules
.opencode.json
GEMINI.md
.gemini/
.aider*

# Claude Code + MCP (local settings and server config)
.claude/
.mcp.json

# Editor preferences
.vscode/
.idea/

# Stray backups
*.save
*.bak

# Generated diagrams (archify skill) and design-system output (ui-ux-pro-max)
.archify/
design-system/

# Markdown: only READMEs ship. Everything else (assistant instructions such as
# CLAUDE.md/AGENTS.md, working reports, QA checklists, prompt templates) is local.
*.md
!README.md
# The UI design system is shared project documentation, not a local note.
!frontend/DESIGN_SYSTEM.md
# How production is deployed (Railway, or a VPS) — shared, no secrets.
!DEPLOY.md

# One-off local debugging scripts: hash.js hard-codes a password, and the
# inspect/list scripts dump patient emails and password hashes.
frontend/hash.js
backend/inspect-db.js
backend/list-dbs.js
